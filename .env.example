# ---------------------------------------------------------------------------
# Squircle server. Copy to .env for local development.
# In production, set these in the Render dashboard. See README.md.
# ---------------------------------------------------------------------------

# NODE_ENV=production
PORT=4000

# The website (GitHub Pages) and this API.
SITE_URL=http://localhost:8080
API_URL=http://localhost:4000
# EXTRA_ORIGINS=https://www.squircle.london

# Database: a local file in development, Turso in production.
DATABASE_URL=file:data/dev.db
# DATABASE_AUTH_TOKEN=

# Long random value. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Always has Admin access, as owner.
OWNER_EMAIL=

# Google — Google Cloud Console → Google Auth Platform → Clients
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Apple — developer.apple.com → Certificates, Identifiers & Profiles
# APPLE_TEAM_ID=
# APPLE_SERVICES_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Local only: adds a "dev" sign-in that skips Apple and Google. Ignored in production.
DEV_SIGN_IN=true

