# ---------------------------------------------------------------------------
# Squircle server. Copy to .env for local development.
# In production, set these in the Render dashboard. See README.md.
# ---------------------------------------------------------------------------

# NODE_ENV=production
PORT=4000

# The website (GitHub Pages) and this API.
SITE_URL=http://localhost:8080
API_URL=http://localhost:4000
# EXTRA_ORIGINS=https://www.squircle.london

# Database: a local file in development, Turso in production.
DATABASE_URL=file:data/dev.db
# DATABASE_AUTH_TOKEN=

# Long random value. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Always has Admin access, as owner.
OWNER_EMAIL=

# Google — Google Cloud Console → Google Auth Platform → Clients
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Apple — developer.apple.com → Certificates, Identifiers & Profiles
# APPLE_TEAM_ID=
# APPLE_SERVICES_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Local only: adds a "dev" sign-in that skips Apple and Google. Ignored in production.
DEV_SIGN_IN=true

# Where publishing goes. "filesystem" writes into a local checkout of the site.
PUBLISH_TARGET=filesystem
SITE_DIR=../manuscript
# PUBLISH_TARGET=github
# GITHUB_TOKEN=
# GITHUB_REPO=Batty-sk/manuscript
# GITHUB_BRANCH=main

# Manuscript subscriptions. "dev" uses a pretend checkout (local only).
BILLING_PROVIDER=dev
# BILLING_PROVIDER=stripe
# STRIPE_API_KEY=rk_live_…           # restricted key, permissions in README
# STRIPE_WEBHOOK_SECRET=whsec_…
# STRIPE_PRICE_ID=price_…          # Manuscript, $9.99 per seat per month
# STRIPE_AUTOMATIC_TAX=true        # once Stripe Tax is set up

# Signs entitlement tokens the Manuscript app verifies offline (EC P-256, PKCS#8).
# Required in production; development makes a throwaway key.
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# ENTITLEMENT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
