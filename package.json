{
  "name": "squircle-server",
  "version": "1.0.0",
  "private": true,
  "description": "Squircle Labs API: accounts (Sign in with Apple, Google), admin and the Newsroom.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "admin:add": "node --env-file-if-exists=.env --import tsx src/scripts/add-admin.ts",
    "newsroom:import": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx src/scripts/import-newsroom.ts",
    "newsroom:rebuild": "node --env-file-if-exists=.env --import tsx src/scripts/rebuild.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "express": "^5.3.0",
    "jose": "^6.2.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
